{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://skills4coder.org/schemas/skill-v1.json",
  "title": "Skills4Coder Skill Definition Schema",
  "description": "Schema for defining skills in the Skills4Coder framework",
  "type": "object",
  "required": ["version", "role", "skills"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version",
      "enum": ["1.0.0"]
    },
    "role": {
      "type": "string",
      "description": "Role identifier",
      "enum": ["developer", "architect", "tester", "ops"]
    },
    "specialization": {
      "type": "string",
      "description": "Optional specialization within the role"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": {
          "type": "object",
          "properties": {
            "en": { "type": "string" },
            "zh": { "type": "string" }
          },
          "required": ["en", "zh"]
        },
        "description": {
          "type": "object",
          "properties": {
            "en": { "type": "string" },
            "zh": { "type": "string" }
          },
          "required": ["en", "zh"]
        },
        "lastUpdated": {
          "type": "string",
          "format": "date"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "github": { "type": "string" },
              "email": { "type": "string" }
            }
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/skillCategory"
      }
    },
    "ecosystemMappings": {
      "type": "object",
      "description": "Mappings to external skill ecosystems",
      "properties": {
        "skillhub": {
          "type": "array",
          "items": { "$ref": "#/definitions/ecosystemMapping" }
        },
        "claw": {
          "type": "array",
          "items": { "$ref": "#/definitions/ecosystemMapping" }
        },
        "mcp": {
          "type": "array",
          "items": { "$ref": "#/definitions/ecosystemMapping" }
        }
      }
    }
  },
  "definitions": {
    "skillCategory": {
      "type": "object",
      "required": ["id", "name", "level", "items"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Unique identifier for the category"
        },
        "name": {
          "type": "object",
          "properties": {
            "en": { "type": "string" },
            "zh": { "type": "string" }
          },
          "required": ["en", "zh"]
        },
        "level": {
          "type": "string",
          "enum": ["beginner", "intermediate", "advanced", "expert"]
        },
        "description": {
          "type": "object",
          "properties": {
            "en": { "type": "string" },
            "zh": { "type": "string" }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/skillItem"
          }
        }
      }
    },
    "skillItem": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "object",
          "properties": {
            "en": { "type": "string" },
            "zh": { "type": "string" }
          },
          "required": ["en", "zh"]
        },
        "description": {
          "type": "object",
          "properties": {
            "en": { "type": "string" },
            "zh": { "type": "string" }
          }
        },
        "importance": {
          "type": "string",
          "enum": ["required", "recommended", "optional"],
          "default": "recommended"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "type": {
                "type": "string",
                "enum": ["article", "video", "course", "book", "documentation", "tool"]
              },
              "level": {
                "type": "string",
                "enum": ["beginner", "intermediate", "advanced"]
              },
              "free": { "type": "boolean", "default": true }
            },
            "required": ["title", "url"]
          }
        },
        "relatedSkills": {
          "type": "array",
          "items": { "type": "string" },
          "description": "IDs of related skills"
        },
        "certifications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "provider": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },
    "ecosystemMapping": {
      "type": "object",
      "required": ["skillId", "externalId"],
      "properties": {
        "skillId": { "type": "string" },
        "externalId": { "type": "string" },
        "externalName": { "type": "string" },
        "externalUrl": { "type": "string", "format": "uri" },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence level of the mapping (0-1)"
        },
        "notes": { "type": "string" }
      }
    }
  }
}
