{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Atomic Skill v1",
  "description": "Schema for atomic skill definitions",
  "type": "object",
  "required": ["id", "type", "version", "metadata", "input", "output", "implementation"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique skill identifier (kebab-case)"
    },
    "type": {
      "const": "atomic-skill"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "metadata": {
      "type": "object",
      "required": ["name", "description", "author", "tags", "category"],
      "properties": {
        "name": { "type": "string" },
        "nameZh": { "type": "string" },
        "description": { "type": "string" },
        "descriptionZh": { "type": "string" },
        "author": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "category": { "type": "string" }
      }
    },
    "input": {
      "type": "object",
      "required": ["schema"],
      "properties": {
        "schema": {
          "type": "object",
          "properties": {
            "type": { "const": "object" },
            "properties": { "type": "object" },
            "required": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["schema"],
      "properties": {
        "schema": {
          "type": "object",
          "properties": {
            "type": { "const": "object" },
            "properties": { "type": "object" }
          }
        }
      }
    },
    "implementation": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["mcp-tool", "native", "api"] },
        "server": { "type": "string" },
        "tool": { "type": "string" },
        "function": { "type": "string" },
        "module": { "type": "string" },
        "endpoint": { "type": "string" },
        "method": { "type": "string" },
        "fallback": { "type": "object" }
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "permissions": { "type": "array", "items": { "type": "string" } },
        "blockedPaths": { "type": "array", "items": { "type": "string" } },
        "maxFileSize": { "type": "number" },
        "allowedExtensions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "errors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["code", "message", "retryable"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "retryable": { "type": "boolean" }
        }
      }
    },
    "learning": {
      "type": "object",
      "description": "岗位技能学习辅助信息（面向贡献者/学习者，不影响运行时调用）",
      "properties": {
        "summary": { "type": "string", "description": "一句话讲清该技能价值" },
        "summaryZh": { "type": "string" },
        "keyPoints": {
          "type": "array",
          "items": { "type": "string" },
          "description": "关键学习要点（考察维度/评判点）"
        },
        "bestPractices": {
          "type": "array",
          "items": { "type": "string" },
          "description": "最佳实践"
        },
        "antiPatterns": {
          "type": "array",
          "items": { "type": "string" },
          "description": "反模式 / 常见陷阱"
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "url"],
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string" },
              "type": { "enum": ["book", "doc", "article", "video", "course", "tool"] }
            }
          },
          "description": "延伸学习资源"
        },
        "maturityLevels": {
          "type": "object",
          "description": "能力分级描述",
          "properties": {
            "junior": { "type": "string" },
            "mid": { "type": "string" },
            "senior": { "type": "string" }
          }
        }
      }
    }
  }
}
