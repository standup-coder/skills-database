{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Role v1",
  "description": "Schema for role (job description) definitions in Skills4Coder",
  "type": "object",
  "required": ["id", "type", "version", "metadata", "jd", "capabilities"],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique role identifier (kebab-case)"
    },
    "type": {
      "const": "role"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "metadata": {
      "type": "object",
      "required": ["name", "description", "author", "tags", "level"],
      "properties": {
        "name": { "type": "string" },
        "nameZh": { "type": "string" },
        "description": { "type": "string" },
        "descriptionZh": { "type": "string" },
        "author": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "level": { "enum": ["junior", "mid", "senior", "lead"] }
      }
    },
    "jd": {
      "type": "object",
      "required": ["summary", "responsibilities", "requirements"],
      "properties": {
        "summary": { "type": "string" },
        "summaryZh": { "type": "string" },
        "responsibilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "responsibilitiesZh": {
          "type": "array",
          "items": { "type": "string" }
        },
        "requirements": {
          "type": "object",
          "properties": {
            "experience": { "type": "string" },
            "education": { "type": "string" },
            "coreSkills": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["mainSkills", "atomicSkills"],
      "properties": {
        "mainSkills": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "atomicSkills": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        }
      }
    },
    "context": {
      "type": "object",
      "description": "Domain-specific context (tech stack, conventions, etc.)"
    },
    "systemPrompt": {
      "type": "object",
      "properties": {
        "role": { "type": "string" },
        "expertise": { "type": "array", "items": { "type": "string" } },
        "communication": {
          "type": "object",
          "properties": {
            "style": { "type": "string" },
            "language": { "type": "string" }
          }
        }
      }
    }
  }
}
