{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Composite Skill v1",
  "description": "Schema for composite skill definitions",
  "type": "object",
  "required": ["id", "type", "version", "metadata", "input", "output", "workflow"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique skill identifier (kebab-case)"
    },
    "type": {
      "const": "composite-skill"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "metadata": {
      "type": "object",
      "required": ["name", "description", "author", "tags", "category"],
      "properties": {
        "name": { "type": "string" },
        "nameZh": { "type": "string" },
        "description": { "type": "string" },
        "descriptionZh": { "type": "string" },
        "author": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "category": { "type": "string" }
      }
    },
    "input": {
      "type": "object",
      "required": ["schema"],
      "properties": {
        "schema": {
          "type": "object",
          "properties": {
            "type": { "const": "object" },
            "properties": { "type": "object" },
            "required": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["schema"],
      "properties": {
        "schema": {
          "type": "object"
        }
      }
    },
    "workflow": {
      "type": "object",
      "required": ["description", "steps"],
      "properties": {
        "description": { "type": "string" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "input", "output"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "nameZh": { "type": "string" },
              "atomicSkill": { "type": "string" },
              "skill": { "type": "string" },
              "type": { "enum": ["llm", "transform", "api"] },
              "input": { "type": "object" },
              "output": { "type": "string" },
              "condition": { "type": ["string", "function"] },
              "dependsOn": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "errorHandling": {
      "type": "object",
      "properties": {
        "strategy": { "enum": ["stop", "continue", "fallback"] },
        "fallback": {
          "type": "object",
          "properties": {
            "step": { "type": "string" },
            "action": { "type": "string" }
          }
        }
      }
    }
  }
}