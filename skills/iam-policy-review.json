{
  "$schema": "../schema/composite-skill-v1.json",
  "id": "iam-policy-review",
  "type": "composite-skill",
  "version": "1.0.0",

  "metadata": {
    "name": "IAM Policy Review",
    "nameZh": "IAM 策略审查",
    "description": "Review cloud IAM policy files to identify over-permissioning, privilege leaks, and least-privilege violations",
    "descriptionZh": "审查云 IAM 策略文件，识别过度授权、权限泄露和最小权限违规",
    "author": "skills4coder-team",
    "tags": ["iam", "policy", "least-privilege", "rbac", "cloud-security"],
    "category": "security"
  },

  "input": {
    "schema": {
      "type": "object",
      "properties": {
        "targetPath": {
          "type": "string",
          "description": "IAM 策略文件路径（Terraform / JSON / YAML）"
        },
        "cloudProvider": {
          "type": "string",
          "enum": ["aws", "azure", "gcp", "tencent-cloud"],
          "default": "aws"
        },
        "strictness": {
          "type": "string",
          "enum": ["strict", "moderate", "permissive"],
          "default": "moderate",
          "description": "审查严格度：strict=最小权限 / moderate=合理授权 / permissive=仅标记高风险"
        }
      },
      "required": ["targetPath"]
    }
  },

  "output": {
    "schema": {
      "type": "object",
      "properties": {
        "passed": { "type": "boolean" },
        "totalPolicies": { "type": "number" },
        "riskPolicies": { "type": "number" },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": { "enum": ["critical", "high", "medium", "low"] },
              "policyName": { "type": "string" },
              "file": { "type": "string" },
              "issue": { "type": "string" },
              "currentPermission": { "type": "string" },
              "recommendedPermission": { "type": "string" },
              "principle": { "type": "string" }
            }
          }
        }
      }
    }
  },

  "workflow": {
    "description": "IAM 策略审查工作流",
    "steps": [
      {
        "id": "list-iam-files",
        "name": "列出 IAM 策略文件",
        "atomicSkill": "run-shell-command",
        "input": {
          "command": "find {{input.targetPath}} -type f \\( -name '*.tf' -o -name '*.json' -o -name '*.yaml' -o -name '*.yml' \\) | xargs grep -liE '(iam_policy|iam_role|role_definition|policy|principal|service_account)' 2>/dev/null | head -50 || echo 'No IAM files found'"
        },
        "output": "iamFiles"
      },
      {
        "id": "read-iam-policies",
        "name": "读取 IAM 策略内容",
        "atomicSkill": "run-shell-command",
        "input": {
          "command": "for f in $(echo '{{steps.list-iam-files.output.stdout}}' | tr '\\n' ' '); do echo '===== '$f' ====='; cat \"$f\" 2>/dev/null; done | head -2000"
        },
        "output": "policyContents"
      },
      {
        "id": "scan-wildcards",
        "name": "扫描通配符权限",
        "atomicSkill": "run-shell-command",
        "input": {
          "command": "grep -rniE '(\\\"Action\\\"\\s*:\\s*\\[\\s*\\\"\\*\\\"|\\\"Resource\\\"\\s*:\\s*\\[\\s*\\\"\\*\\\"|Effect.*Allow.*\\*)' {{input.targetPath}} --include='*.tf' --include='*.json' --include='*.yaml' --include='*.yml' || echo 'No wildcard permissions found'"
        },
        "output": "wildcardScan"
      },
      {
        "id": "scan-admin-access",
        "name": "扫描管理员权限",
        "atomicSkill": "run-shell-command",
        "input": {
          "command": "grep -rniE '(AdministratorAccess|owner|contributor|\\*:\\*|roles/admin|roles/Owner|roles/Contributor)' {{input.targetPath}} --include='*.tf' --include='*.json' --include='*.yaml' --include='*.yml' || echo 'No admin access found'"
        },
        "output": "adminScan"
      },
      {
        "id": "llm-review",
        "name": "AI 策略审查",
        "type": "llm",
        "input": {
          "iamFiles": "{{steps.list-iam-files.output.stdout}}",
          "policyContents": "{{steps.read-iam-policies.output}}",
          "wildcards": "{{steps.scan-wildcards.output.stdout}}",
          "adminAccess": "{{steps.scan-admin-access.output.stdout}}",
          "cloudProvider": "{{input.cloudProvider}}",
          "strictness": "{{input.strictness}}"
        },
        "prompt": "你是一位云 IAM 安全专家。请审查以下 IAM 策略配置，重点检查：1) 通配符权限过度 2) 管理员权限滥用 3) 违反最小权限原则 4) 缺少条件约束 5) 跨账户信任配置。按 strictness 级别输出 findings（含 severity/policyName/file/issue/currentPermission/recommendedPermission/principle），以及整体通过状态。",
        "output": "reviewResult"
      },
      {
        "id": "format-output",
        "name": "格式化输出",
        "type": "transform",
        "input": {
          "reviewResult": "{{steps.llm-review.output}}"
        },
        "transform": "formatIAMPolicyReview",
        "output": "finalResult"
      }
    ]
  },

  "errorHandling": {
    "strategy": "continue",
    "fallback": {
      "step": "llm-review",
      "action": "skip-partial"
    }
  }
}
