{
  "$schema": "../schema/composite-skill-v1.json",
  "id": "k8s-deployment-review",
  "type": "composite-skill",
  "version": "1.0.0",
  "metadata": {
    "name": "Kubernetes Deployment Review",
    "nameZh": "K8s 部署审查",
    "description": "Review Kubernetes Deployment YAML for configuration correctness, security, and best practices",
    "descriptionZh": "审查 Kubernetes Deployment YAML 的配置正确性、安全性与最佳实践",
    "author": "skills4coder-team",
    "tags": [
      "kubernetes",
      "security",
      "review",
      "ops"
    ],
    "category": "operations"
  },
  "input": {
    "schema": {
      "type": "object",
      "properties": {
        "manifestPath": {
          "type": "string",
          "description": "YAML 文件路径"
        },
        "focus": {
          "type": "array",
          "items": {
            "enum": [
              "security",
              "performance",
              "best-practice"
            ]
          },
          "default": [
            "security",
            "best-practice"
          ]
        }
      },
      "required": [
        "manifestPath"
      ]
    }
  },
  "output": {
    "schema": {
      "type": "object",
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "score": {
          "type": "number"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": {
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "category": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "suggestion": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "workflow": {
    "description": "K8s 部署审查工作流",
    "steps": [
      {
        "id": "read-manifest",
        "name": "读取清单",
        "atomicSkill": "read-file",
        "input": {
          "path": "{{input.manifestPath}}"
        },
        "output": "manifestContent"
      },
      {
        "id": "validate-manifest",
        "name": "校验清单",
        "atomicSkill": "validate-k8s-manifest",
        "input": {
          "manifestContent": "{{steps.read-manifest.output.content}}",
          "strict": true
        },
        "output": "validationResult"
      },
      {
        "id": "security-review",
        "name": "安全审查",
        "type": "llm",
        "condition": "{{input.focus.includes('security')}}",
        "input": {
          "content": "{{steps.read-manifest.output.content}}"
        },
        "prompt": "你是一位 Kubernetes 安全专家。请审查以下 Deployment YAML，列出所有安全问题（如特权容器、缺失 securityContext、敏感信息硬编码等），按 critical/high/medium/low 分级，并给出修复建议。",
        "output": "securityIssues"
      },
      {
        "id": "best-practice-review",
        "name": "最佳实践审查",
        "type": "llm",
        "condition": "{{input.focus.includes('best-practice')}}",
        "input": {
          "content": "{{steps.read-manifest.output.content}}"
        },
        "prompt": "你是一位资深 SRE。请审查以下 Deployment YAML 是否符合生产最佳实践（资源限制、健康探针、滚动更新策略、副本数等），列出问题并给出建议。",
        "output": "practiceIssues"
      },
      {
        "id": "format-output",
        "name": "格式化输出",
        "type": "transform",
        "input": {
          "validation": "{{steps.validate-manifest.output}}",
          "security": "{{steps.security-review.output}}",
          "practice": "{{steps.best-practice-review.output}}"
        },
        "transform": "formatK8sReviewOutput",
        "output": "finalResult"
      }
    ]
  },
  "errorHandling": {
    "strategy": "continue",
    "fallback": {
      "step": "format-output",
      "action": "skip-partial"
    }
  }
}
