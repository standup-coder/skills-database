{
  "$schema": "../schema/composite-skill-v1.json",
  "id": "incident-postmortem",
  "type": "composite-skill",
  "version": "1.0.0",
  "metadata": {
    "name": "Incident Postmortem",
    "nameZh": "事故复盘",
    "description": "Run a blameless postmortem with timeline reconstruction, root cause and durable action items",
    "descriptionZh": "以无指责为原则运作事故复盘：时间线 → 根因 → 教训 → 行动项 → 知识沉淀",
    "author": "skills4coder-team",
    "tags": ["postmortem", "incident", "sre", "blameless", "reliability"],
    "category": "operations"
  },
  "input": {
    "schema": {
      "type": "object",
      "properties": {
        "incidentId": { "type": "string" },
        "severity": { "type": "string", "enum": ["sev1", "sev2", "sev3", "sev4"] },
        "rawTimeline": { "type": "array" },
        "impactedServices": { "type": "array", "items": { "type": "string" } },
        "userImpact": { "type": "string" }
      },
      "required": ["incidentId", "severity"]
    }
  },
  "output": {
    "schema": {
      "type": "object",
      "properties": {
        "timeline": { "type": "array" },
        "rootCause": { "type": "string" },
        "contributingFactors": { "type": "array" },
        "lessonsLearned": { "type": "array" },
        "actionItems": { "type": "array" },
        "postmortemDoc": { "type": "string" }
      }
    }
  },
  "workflow": {
    "description": "Blameless postmortem 五步法",
    "steps": [
      {
        "id": "timeline",
        "name": "时间线重建",
        "nameZh": "时间线重建",
        "atomicSkill": "incident-runbook",
        "input": { "raw": "{{input.rawTimeline}}", "incidentId": "{{input.incidentId}}" },
        "output": "timeline"
      },
      {
        "id": "rca",
        "name": "根因分析",
        "nameZh": "根因分析",
        "type": "llm",
        "input": { "timeline": "{{steps.timeline.output}}", "services": "{{input.impactedServices}}" },
        "prompt": "用 5 Whys + 鱼骨图找根因，区分 root cause / contributing factors / triggers",
        "output": "rootCause",
        "dependsOn": ["timeline"]
      },
      {
        "id": "lessons",
        "name": "教训提炼",
        "nameZh": "教训提炼",
        "type": "llm",
        "input": { "rca": "{{steps.rca.output}}", "timeline": "{{steps.timeline.output}}" },
        "prompt": "从检测/响应/恢复/沟通四维度提炼可迁移的教训，避免单点指责",
        "output": "lessonsLearned",
        "dependsOn": ["rca"]
      },
      {
        "id": "actions",
        "name": "行动项与负责人",
        "nameZh": "行动项与负责人",
        "type": "transform",
        "input": { "lessons": "{{steps.lessons.output}}" },
        "output": "actionItems",
        "dependsOn": ["lessons"]
      },
      {
        "id": "doc",
        "name": "复盘文档与公开",
        "nameZh": "复盘文档与公开",
        "type": "llm",
        "input": { "all": "{{steps}}", "userImpact": "{{input.userImpact}}", "severity": "{{input.severity}}" },
        "prompt": "按 Google SRE postmortem 模板输出文档，含 user impact、timeline、RCA、actions、lessons",
        "output": "postmortemDoc",
        "dependsOn": ["actions"]
      }
    ]
  },
  "errorHandling": { "strategy": "continue" }
}
