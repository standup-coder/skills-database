{
  "$schema": "../schema/composite-skill-v1.json",
  "id": "mobile-release-pipeline",
  "type": "composite-skill",
  "version": "1.0.0",
  "metadata": {
    "name": "Mobile Release Pipeline",
    "nameZh": "移动端发布流水线",
    "description": "End-to-end mobile release pipeline: build, sign, beta, store submission and rollback",
    "descriptionZh": "覆盖移动端发布全流程：多渠道构建、签名、灰度、商店提交与回滚",
    "author": "skills4coder-team",
    "tags": ["mobile", "ci-cd", "fastlane", "code-signing", "release-train"],
    "category": "mobile"
  },
  "input": {
    "schema": {
      "type": "object",
      "properties": {
        "platforms": { "type": "array", "items": { "enum": ["ios", "android"] } },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "rolloutStrategy": { "type": "string", "enum": ["full", "staged", "ab-test"] },
        "betaChannel": { "type": "string", "enum": ["testflight", "firebase-app-distribution", "internal"] }
      },
      "required": ["platforms", "version"]
    }
  },
  "output": {
    "schema": {
      "type": "object",
      "properties": {
        "buildArtifacts": { "type": "array" },
        "signingReport": { "type": "object" },
        "submissionResult": { "type": "object" },
        "rollbackPlan": { "type": "string" }
      }
    }
  },
  "workflow": {
    "description": "Build → Sign → Beta → Submit → Monitor → Rollback",
    "steps": [
      {
        "id": "build",
        "name": "多平台构建",
        "nameZh": "多平台构建",
        "atomicSkill": "ios-development",
        "input": { "platforms": "{{input.platforms}}", "version": "{{input.version}}" },
        "output": "buildArtifacts"
      },
      {
        "id": "sign",
        "name": "签名与公证",
        "nameZh": "签名与公证",
        "type": "transform",
        "input": { "artifacts": "{{steps.build.output}}" },
        "output": "signingReport",
        "dependsOn": ["build"]
      },
      {
        "id": "beta",
        "name": "Beta 分发",
        "nameZh": "Beta 分发",
        "type": "api",
        "input": { "artifacts": "{{steps.sign.output}}", "channel": "{{input.betaChannel}}" },
        "output": "betaResult",
        "dependsOn": ["sign"]
      },
      {
        "id": "submit",
        "name": "商店提交",
        "nameZh": "商店提交",
        "type": "api",
        "input": { "artifacts": "{{steps.sign.output}}", "rollout": "{{input.rolloutStrategy}}" },
        "output": "submissionResult",
        "dependsOn": ["beta"]
      },
      {
        "id": "monitor",
        "name": "上线监控",
        "nameZh": "上线监控",
        "atomicSkill": "health-monitoring",
        "input": { "version": "{{input.version}}" },
        "output": "monitorResult",
        "dependsOn": ["submit"]
      },
      {
        "id": "rollback-plan",
        "name": "回滚预案",
        "nameZh": "回滚预案",
        "type": "llm",
        "input": { "version": "{{input.version}}", "rollout": "{{input.rolloutStrategy}}" },
        "prompt": "输出按渠道分级的回滚 SOP（含 staged rollout 暂停、kill switch、forced update）",
        "output": "rollbackPlan",
        "dependsOn": ["submit"]
      }
    ]
  },
  "errorHandling": { "strategy": "stop" }
}
