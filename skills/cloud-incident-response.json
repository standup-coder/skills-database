{
  "$schema": "../schema/composite-skill-v1.json",
  "id": "cloud-incident-response",
  "type": "composite-skill",
  "version": "1.0.0",

  "metadata": {
    "name": "Cloud Incident Response",
    "nameZh": "云安全事件响应",
    "description": "Detection, analysis, containment, and remediation of cloud security incidents, supporting scenarios such as credential compromise and data exfiltration",
    "descriptionZh": "云安全事件的检测、分析、遏制和修复，支持凭据泄露、数据外泄等场景",
    "author": "skills4coder-team",
    "tags": ["incident-response", "cloud-security", "forensics", "containment"],
    "category": "security"
  },

  "input": {
    "schema": {
      "type": "object",
      "properties": {
        "incidentType": {
          "type": "string",
          "enum": ["credential-compromise", "data-exfiltration", "cryptojacking", "misconfiguration-exposure", "unauthorized-access", "malware-container"],
          "description": "事件类型"
        },
        "cloudProvider": {
          "type": "string",
          "enum": ["aws", "azure", "gcp", "tencent-cloud"],
          "default": "aws"
        },
        "evidencePath": {
          "type": "string",
          "description": "证据文件路径（日志、配置快照等）"
        },
        "affectedResources": {
          "type": "array",
          "items": { "type": "string" },
          "description": "受影响资源列表"
        }
      },
      "required": ["incidentType", "cloudProvider"]
    }
  },

  "output": {
    "schema": {
      "type": "object",
      "properties": {
        "severity": { "enum": ["critical", "high", "medium", "low"] },
        "status": { "enum": ["detected", "analyzing", "contained", "resolved"] },
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "timestamp": { "type": "string" },
              "event": { "type": "string" },
              "source": { "type": "string" },
              "severity": { "type": "string" }
            }
          }
        },
        "rootCause": { "type": "string" },
        "affectedResources": { "type": "array", "items": { "type": "string" } },
        "containmentSteps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": { "type": "string" },
              "priority": { "enum": ["immediate", "short-term", "long-term"] },
              "command": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "remediationPlan": {
          "type": "array",
          "items": { "type": "string" }
        },
        "lessonsLearned": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },

  "workflow": {
    "description": "云安全事件响应工作流",
    "steps": [
      {
        "id": "collect-evidence",
        "name": "收集证据",
        "atomicSkill": "run-shell-command",
        "condition": "{{input.evidencePath}}",
        "input": {
          "command": "find {{input.evidencePath}} -type f \\( -name '*.log' -o -name '*.json' -o -name '*.csv' -o -name '*.tf' -o -name '*.yaml' \\) | head -50"
        },
        "output": "evidenceFiles"
      },
      {
        "id": "analyze-access-logs",
        "name": "分析访问日志",
        "atomicSkill": "run-shell-command",
        "condition": "{{input.evidencePath}}",
        "input": {
          "command": "grep -rniE '(Unauthorized|AccessDenied|ConsoleLogin|AssumeRole|DeleteBucket|GetObject|iam.*Create|security_group.*Authorize)' {{input.evidencePath}} --include='*.log' --include='*.json' --include='*.csv' 2>/dev/null | tail -100 || echo 'No suspicious access patterns found'"
        },
        "output": "accessAnomalies"
      },
      {
        "id": "scan-credential-exposure",
        "name": "扫描凭据泄露",
        "atomicSkill": "run-shell-command",
        "condition": "{{input.incidentType}} == 'credential-compromise'",
        "input": {
          "command": "grep -rniE '(AKIA|ASIA|private_key|secret_access_key|password|token|credentials)' {{input.evidencePath}} --include='*.log' --include='*.json' --include='*.env' 2>/dev/null | tail -50 || echo 'No credential exposure detected'"
        },
        "output": "credentialScan"
      },
      {
        "id": "llm-incident-analysis",
        "name": "AI 事件分析",
        "type": "llm",
        "input": {
          "incidentType": "{{input.incidentType}}",
          "cloudProvider": "{{input.cloudProvider}}",
          "evidenceFiles": "{{steps.collect-evidence.output.stdout}}",
          "accessAnomalies": "{{steps.analyze-access-logs.output.stdout}}",
          "credentialScan": "{{steps.scan-credential-exposure.output.stdout}}",
          "affectedResources": "{{input.affectedResources}}"
        },
        "prompt": "你是一位云安全事件响应专家。请分析以下 {{input.incidentType}} 类型的事件。根据证据和日志：1) 重建事件时间线 2) 确定根本原因 3) 评估影响范围和严重性 4) 制定立即遏制措施（含具体云 CLI 命令）5) 制定修复计划 6) 总结经验教训。输出 JSON 格式结果。",
        "output": "incidentAnalysis"
      },
      {
        "id": "format-output",
        "name": "格式化输出",
        "type": "transform",
        "input": {
          "incidentAnalysis": "{{steps.llm-incident-analysis.output}}"
        },
        "transform": "formatCloudIncidentResponse",
        "output": "finalResult"
      }
    ]
  },

  "errorHandling": {
    "strategy": "continue",
    "fallback": {
      "step": "llm-incident-analysis",
      "action": "skip-partial"
    }
  }
}
