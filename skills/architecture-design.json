{
  "$schema": "../schema/composite-skill-v1.json",
  "id": "architecture-design",
  "type": "composite-skill",
  "version": "1.0.0",
  "metadata": {
    "name": "Architecture Design",
    "nameZh": "架构设计",
    "description": "Design system architecture and component diagrams",
    "descriptionZh": "设计系统架构和组件图",
    "author": "skills4coder-team",
    "tags": [
      "architecture",
      "system-design",
      "microservices"
    ],
    "category": "architecture"
  },
  "input": {
    "schema": {
      "type": "object",
      "properties": {},
      "required": []
    }
  },
  "output": {
    "schema": {
      "type": "object",
      "properties": {},
      "required": []
    }
  },
  "workflow": {
    "description": "Design system architecture and component diagrams",
    "steps": [
      {
        "id": "analyze-context",
        "name": "Analyze Context",
        "nameZh": "分析上下文",
        "type": "llm",
        "input": {},
        "output": "context"
      },
      {
        "id": "design-arch",
