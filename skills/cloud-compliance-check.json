{
  "$schema": "../schema/composite-skill-v1.json",
  "id": "cloud-compliance-check",
  "type": "composite-skill",
  "version": "1.0.0",

  "metadata": {
    "name": "Cloud Compliance Check",
    "nameZh": "云合规检查",
    "description": "Check cloud resource configurations against compliance frameworks (CIS, SOC2, GDPR, HIPAA, PCI-DSS)",
    "descriptionZh": "对云资源配置进行合规框架检查（CIS、SOC2、GDPR、HIPAA、PCI-DSS）",
    "author": "skills4coder-team",
    "tags": ["compliance", "cis", "soc2", "gdpr", "hipaa", "pci-dss", "cloud"],
    "category": "security"
  },

  "input": {
    "schema": {
      "type": "object",
      "properties": {
        "targetPath": {
          "type": "string",
          "description": "云资源配置路径"
        },
        "framework": {
          "type": "string",
          "enum": ["CIS", "SOC2", "GDPR", "HIPAA", "PCI-DSS", "ISO27001"],
          "description": "合规框架"
        },
        "cloudProvider": {
          "type": "string",
          "enum": ["aws", "azure", "gcp", "tencent-cloud"]
        }
      },
      "required": ["targetPath", "framework", "cloudProvider"]
    }
  },

  "output": {
    "schema": {
      "type": "object",
      "properties": {
        "compliant": { "type": "boolean" },
        "framework": { "type": "string" },
        "totalControls": { "type": "number" },
        "passedControls": { "type": "number" },
        "failedControls": { "type": "number" },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "controlId": { "type": "string" },
              "controlName": { "type": "string" },
              "status": { "enum": ["pass", "fail", "warning", "not-applicable"] },
              "severity": { "enum": ["critical", "high", "medium", "low"] },
              "evidence": { "type": "string" },
              "remediation": { "type": "string" }
            }
          }
        }
      }
    }
  },

  "workflow": {
    "description": "云合规检查工作流",
    "steps": [
      {
        "id": "list-resources",
        "name": "列出资源文件",
        "atomicSkill": "run-shell-command",
        "input": {
          "command": "find {{input.targetPath}} -type f \\( -name '*.tf' -o -name '*.yaml' -o -name '*.yml' -o -name '*.json' \\) | head -80"
        },
        "output": "resourceFiles"
      },
      {
        "id": "scan-logging-config",
        "name": "检查日志审计配置",
        "atomicSkill": "run-shell-command",
        "input": {
          "command": "grep -rniE '(cloudtrail|cloud_watch|flow_log|audit_log|activity_log|cloudaudit)' {{input.targetPath}} --include='*.tf' --include='*.json' --include='*.yaml' --include='*.yml' || echo 'No logging configuration found'"
        },
        "output": "loggingConfig"
      },
      {
        "id": "scan-encryption-config",
        "name": "检查加密配置",
        "atomicSkill": "run-shell-command",
        "input": {
          "command": "grep -rniE '(encryption|kms|sse|cmk|customer.managed.key|tls)' {{input.targetPath}} --include='*.tf' --include='*.json' --include='*.yaml' --include='*.yml' || echo 'No encryption config found'"
        },
        "output": "encryptionConfig"
      },
      {
        "id": "llm-compliance",
        "name": "AI 合规分析",
        "type": "llm",
        "input": {
          "resourceFiles": "{{steps.list-resources.output.stdout}}",
          "loggingConfig": "{{steps.scan-logging-config.output.stdout}}",
          "encryptionConfig": "{{steps.scan-encryption-config.output.stdout}}",
          "framework": "{{input.framework}}",
          "cloudProvider": "{{input.cloudProvider}}"
        },
        "prompt": "你是一位云合规审计专家。请根据以下云资源配置，按 {{input.framework}} 框架进行合规检查。重点关注：日志审计、数据加密、访问控制、网络隔离、备份恢复等控制域。输出每条控制的检查结果（controlId/controlName/status/severity/evidence/remediation），以及整体合规状态。",
        "output": "complianceResult"
      },
      {
        "id": "format-output",
        "name": "格式化输出",
        "type": "transform",
        "input": {
          "complianceResult": "{{steps.llm-compliance.output}}"
        },
        "transform": "formatComplianceCheck",
        "output": "finalResult"
      }
    ]
  },

  "errorHandling": {
    "strategy": "continue",
    "fallback": {
      "step": "llm-compliance",
      "action": "skip-partial"
    }
  }
}
