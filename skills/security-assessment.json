{
  "id": "security-assessment",
  "type": "composite-skill",
  "version": "1.0.0",
  "metadata": {
    "name": "Security Assessment",
    "nameZh": "安全评估",
    "description": "Comprehensive security architecture and vulnerability assessment",
    "descriptionZh": "综合安全架构和漏洞评估",
    "author": "skills4coder-team",
    "tags": [
      "security",
      "vulnerability",
      "penetration",
      "compliance"
    ],
    "category": "security"
  },
  "input": {
    "schema": {
      "type": "object",
      "properties": {},
      "required": []
    }
  },
  "output": {
    "schema": {
      "type": "object",
      "properties": {},
      "required": []
    }
  },
  "workflow": {
    "description": "Comprehensive security architecture and vulnerability assessment",
    "steps": [
      {
        "id": "threat-modeling",
        "name": "Threat Modeling",
        "nameZh": "威胁建模",
        "type": "llm",
        "input": {},
        "output": "threat_model"
      },
      {
        "id": "vulnerability-scan",
        "name": "Vulnerability Scan",
        "nameZh": "漏洞扫描",
        "type": "llm",
        "input": {
          "model": "{{steps.threat-modeling.output}}"
        },
        "output": "vulns"
      },
      {
        "id": "generate-report",
        "name": "Generate Report",
        "nameZh": "生成报告",
        "atomicSkill": "write-file",
        "input": {
          "path": "security-report.md",
          "content": "{{steps.vulnerability-scan.output}}"
        },
        "output": "report",
        "dependsOn": [
          "vulnerability-scan"
        ]
      }
    ]
  }
}