{
  "$schema": "../schema/skill-v1.json",
  "id": "security-audit",
  "type": "composite-skill",
  "version": "1.0.0",

  "metadata": {
    "name": "Security Audit",
    "nameZh": "安全审计",
    "description": "对配置文件、代码和云资源进行安全扫描与合规检查",
    "descriptionZh": "对配置文件、代码和云资源进行安全扫描与合规检查",
    "author": "skills4coder-team",
    "tags": ["security", "audit", "compliance", "ops"],
    "category": "operations"
  },

  "input": {
    "schema": {
      "type": "object",
      "properties": {
        "targetPath": {
          "type": "string",
          "description": "审计目标路径"
        },
        "scope": {
          "type": "array",
          "items": { "enum": ["k8s", "terraform", "secrets", "dependencies"] },
          "default": ["k8s", "terraform", "secrets"]
        }
      },
      "required": ["targetPath"]
    }
  },

  "output": {
    "schema": {
      "type": "object",
      "properties": {
        "passed": { "type": "boolean" },
        "score": { "type": "number" },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": { "enum": ["critical", "high", "medium", "low"] },
              "category": { "type": "string" },
              "file": { "type": "string" },
              "message": { "type": "string" },
              "remediation": { "type": "string" }
            }
          }
        }
      }
    }
  },

  "workflow": {
    "description": "安全审计工作流",
    "steps": [
      {
        "id": "list-files",
        "name": "列出目标文件",
        "atomicSkill": "run-shell-command",
        "input": {
          "command": "find {{input.targetPath}} -type f \\( -name '*.yaml' -o -name '*.yml' -o -name '*.tf' -o -name '*.json' \\) | head -50"
        },
        "output": "fileList"
      },
      {
        "id": "scan-secrets",
        "name": "扫描敏感信息",
        "atomicSkill": "run-shell-command",
        "condition": "{{input.scope.includes('secrets')}}",
        "input": {
          "command": "grep -rniE '(password|secret|token|api_key|private_key)' {{input.targetPath}} --include='*.yaml' --include='*.yml' --include='*.tf' --include='*.json' --include='*.env' || echo 'No obvious secrets found'"
        },
        "output": "secretScanResult"
      },
      {
        "id": "llm-audit",
        "name": "AI 安全审计",
        "type": "llm",
        "input": {
          "files": "{{steps.list-files.output.stdout}}",
          "secrets": "{{steps.secret-scan-secrets.output}}",
          "scope": "{{input.scope}}"
        },
        "prompt": "你是一位安全审计专家。请根据以下文件列表和敏感信息扫描结果，评估目标项目的安全风险。按 critical/high/medium/low 分级列出发现项（findings），给出综合评分（0-100）和是否通过（passed）。",
        "output": "auditResult"
      },
      {
        "id": "format-output",
        "name": "格式化输出",
        "type": "transform",
        "input": {
          "auditResult": "{{steps.llm-audit.output}}"
        },
        "transform": "formatSecurityAuditOutput",
        "output": "finalResult"
      }
    ]
  },

  "errorHandling": {
    "strategy": "continue",
    "fallback": {
      "step": "llm-audit",
      "action": "skip-partial"
    }
  }
}
