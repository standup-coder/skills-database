{
  "$schema": "../schema/skill-v1.json",
  "id": "cloud-security-assessment",
  "type": "composite-skill",
  "version": "1.0.0",

  "metadata": {
    "name": "Cloud Security Assessment",
    "nameZh": "云安全评估",
    "description": "对云基础设施配置进行安全评估，识别错误配置、权限泄露和合规风险",
    "descriptionZh": "对云基础设施配置进行安全评估，识别错误配置、权限泄露和合规风险",
    "author": "skills4coder-team",
    "tags": ["cloud-security", "assessment", "cspm", "compliance"],
    "category": "security"
  },

  "input": {
    "schema": {
      "type": "object",
      "properties": {
        "targetPath": {
          "type": "string",
          "description": "云资源配置目标路径（Terraform / CloudFormation / K8s manifests）"
        },
        "cloudProvider": {
          "type": "string",
          "enum": ["aws", "azure", "gcp", "tencent-cloud", "multi-cloud"],
          "default": "aws"
        },
        "frameworks": {
          "type": "array",
          "items": { "enum": ["CIS", "SOC2", "GDPR", "HIPAA", "PCI-DSS", "ISO27001"] },
          "default": ["CIS"]
        }
      },
      "required": ["targetPath"]
    }
  },

  "output": {
    "schema": {
      "type": "object",
      "properties": {
        "passed": { "type": "boolean" },
        "riskScore": { "type": "number" },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
              "category": { "type": "string" },
              "resource": { "type": "string" },
              "file": { "type": "string" },
              "message": { "type": "string" },
              "remediation": { "type": "string" },
              "frameworkReference": { "type": "string" }
            }
          }
        },
        "compliance": {
          "type": "object",
          "properties": {
            "framework": { "type": "string" },
            "totalChecks": { "type": "number" },
            "passedChecks": { "type": "number" },
            "failedChecks": { "type": "number" }
          }
        }
      }
    }
  },

  "workflow": {
    "description": "云安全评估工作流",
    "steps": [
      {
        "id": "list-cloud-configs",
        "name": "列出云资源配置文件",
        "atomicSkill": "run-shell-command",
        "input": {
          "command": "find {{input.targetPath}} -type f \\( -name '*.tf' -o -name '*.yaml' -o -name '*.yml' -o -name '*.json' -o -name '*.template' \\) | head -100"
        },
        "output": "configFiles"
      },
      {
        "id": "scan-iam-risks",
        "name": "扫描 IAM 风险",
        "atomicSkill": "run-shell-command",
        "input": {
          "command": "grep -rniE '(\\*:\\*|AdministratorAccess|\"\\*\"|action.*\\*)' {{input.targetPath}} --include='*.tf' --include='*.json' --include='*.yaml' --include='*.yml' || echo 'No overly permissive IAM found'"
        },
        "output": "iamScanResult"
      },
      {
        "id": "scan-exposed-resources",
        "name": "扫描公开暴露资源",
        "atomicSkill": "run-shell-command",
        "input": {
          "command": "grep -rniE '(0\\.0\\.0\\.0/0|public|Internet-facing|ingress.*all)' {{input.targetPath}} --include='*.tf' --include='*.json' --include='*.yaml' --include='*.yml' || echo 'No publicly exposed resources found'"
        },
        "output": "exposureScanResult"
      },
      {
        "id": "scan-unencrypted-data",
        "name": "扫描未加密数据存储",
        "atomicSkill": "run-shell-command",
        "input": {
          "command": "grep -rniE '(encryption.*false|encrypted.*false|kms_key_id|sse.*disabled)' {{input.targetPath}} --include='*.tf' --include='*.json' --include='*.yaml' --include='*.yml' || echo 'No unencrypted storage found'"
        },
        "output": "encryptionScanResult"
      },
      {
        "id": "llm-assessment",
        "name": "AI 安全评估",
        "type": "llm",
        "input": {
          "configFiles": "{{steps.list-cloud-configs.output.stdout}}",
          "iamRisks": "{{steps.scan-iam-risks.output.stdout}}",
          "exposureRisks": "{{steps.scan-exposed-resources.output.stdout}}",
          "encryptionRisks": "{{steps.scan-unencrypted-data.output.stdout}}",
          "cloudProvider": "{{input.cloudProvider}}",
          "frameworks": "{{input.frameworks}}"
        },
        "prompt": "你是一位云安全专家。请根据以下云资源配置文件的扫描结果，进行全面的安全评估。重点关注：1) IAM 权限过度 2) 资源公开暴露 3) 数据未加密 4) 网络安全组配置 5) 日志监控缺失。按照指定合规框架进行对照检查。输出 JSON 格式的 findings（含 severity/category/resource/file/message/remediation/frameworkReference）、riskScore（0-100）和 passed 状态。",
        "output": "assessmentResult"
      },
      {
        "id": "format-output",
        "name": "格式化输出",
        "type": "transform",
        "input": {
          "assessmentResult": "{{steps.llm-assessment.output}}"
        },
        "transform": "formatCloudSecurityAssessment",
        "output": "finalResult"
      }
    ]
  },

  "errorHandling": {
    "strategy": "continue",
    "fallback": {
      "step": "llm-assessment",
      "action": "skip-partial"
    }
  }
}
