{
  "$schema": "../schema/composite-skill-v1.json",
  "id": "ci-pipeline-setup",
  "type": "composite-skill",
  "version": "1.0.0",

  "metadata": {
    "name": "CI Pipeline Setup",
    "nameZh": "CI 流水线搭建",
    "description": "Generate CI/CD pipeline configurations such as GitHub Actions for projects",
    "descriptionZh": "为项目生成 GitHub Actions 等 CI/CD 流水线配置",
    "author": "skills4coder-team",
    "tags": ["cicd", "github-actions", "automation", "ops"],
    "category": "operations"
  },

  "input": {
    "schema": {
      "type": "object",
      "properties": {
        "projectPath": {
          "type": "string",
          "description": "项目根目录路径"
        },
        "techStack": {
          "type": "array",
          "items": { "type": "string" },
          "description": "技术栈，如 [\"nodejs\", \"docker\"]"
        },
        "stages": {
          "type": "array",
          "items": { "enum": ["lint", "test", "build", "security-scan", "deploy"] },
          "default": ["lint", "test", "build"]
        }
      },
      "required": ["projectPath"]
    }
  },

  "output": {
    "schema": {
      "type": "object",
      "properties": {
        "workflowYaml": { "type": "string" },
        "summary": { "type": "string" },
        "filesToCreate": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },

  "workflow": {
    "description": "CI 流水线搭建工作流",
    "steps": [
      {
        "id": "inspect-project",
        "name": "扫描项目结构",
        "atomicSkill": "run-shell-command",
        "input": {
          "command": "ls -la {{input.projectPath}} && cat {{input.projectPath}}/package.json 2>/dev/null || cat {{input.projectPath}}/pyproject.toml 2>/dev/null || echo 'no lockfile found'"
        },
        "output": "projectInfo"
      },
      {
        "id": "generate-workflow",
        "name": "生成工作流",
        "type": "llm",
        "input": {
          "projectInfo": "{{steps.inspect-project.output.stdout}}",
          "techStack": "{{input.techStack}}",
          "stages": "{{input.stages}}"
        },
        "prompt": "你是一位 CI/CD 专家。根据项目结构和技术栈，生成一份 GitHub Actions workflow YAML。要求：1) 包含用户指定的 stages；2) 使用矩阵构建或多环境策略；3) 加入安全扫描（如依赖漏洞检查）；4) 输出完整可复制的 YAML 和简要说明。",
        "output": "workflowResult"
      },
      {
        "id": "format-output",
        "name": "格式化输出",
        "type": "transform",
        "input": {
          "workflowResult": "{{steps.generate-workflow.output}}"
        },
        "transform": "formatCIPipelineOutput",
        "output": "finalResult"
      }
    ]
  },

  "errorHandling": {
    "strategy": "continue",
    "fallback": {
      "step": "generate-workflow",
      "action": "use-template"
    }
  }
}
