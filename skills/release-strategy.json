{
  "$schema": "../schema/composite-skill-v1.json",
  "id": "release-strategy",
  "type": "composite-skill",
  "version": "1.0.0",
  "metadata": {
    "name": "Release Strategy",
    "nameZh": "发布策略",
    "description": "Design a progressive delivery strategy with feature flags, canary, rollback and observability",
    "descriptionZh": "以渐进式交付为核心设计发布策略：分级灰度 + 特性开关 + 自动回滚 + 可观测验证",
    "author": "skills4coder-team",
    "tags": ["release", "progressive-delivery", "feature-flag", "canary", "rollback"],
    "category": "operations"
  },
  "input": {
    "schema": {
      "type": "object",
      "properties": {
        "releaseScope": { "type": "string" },
        "riskLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "trafficSegments": { "type": "array", "items": { "type": "string" } },
        "rollbackBudgetMinutes": { "type": "integer", "minimum": 1 }
      },
      "required": ["releaseScope", "riskLevel"]
    }
  },
  "output": {
    "schema": {
      "type": "object",
      "properties": {
        "deliveryPlan": { "type": "object" },
        "flagPlan": { "type": "object" },
        "canaryStages": { "type": "array" },
        "rollbackTriggers": { "type": "array" },
        "verificationDashboard": { "type": "string" }
      }
    }
  },
  "workflow": {
    "description": "渐进式发布五步法",
    "steps": [
      {
        "id": "tradeoff",
        "name": "策略权衡",
        "nameZh": "策略权衡",
        "type": "llm",
        "input": { "scope": "{{input.releaseScope}}", "risk": "{{input.riskLevel}}" },
        "prompt": "在 big-bang / blue-green / canary / shadow 之间选型，输出 ADR",
        "output": "strategyAdr"
      },
      {
        "id": "flags",
        "name": "特性开关设计",
        "nameZh": "特性开关设计",
        "type": "transform",
        "input": { "scope": "{{input.releaseScope}}", "segments": "{{input.trafficSegments}}" },
        "output": "flagPlan",
        "dependsOn": ["tradeoff"]
      },
      {
        "id": "canary",
        "name": "Canary 阶段定义",
        "nameZh": "Canary 阶段定义",
        "type": "transform",
        "input": { "flags": "{{steps.flags.output}}", "risk": "{{input.riskLevel}}" },
        "output": "canaryStages",
        "dependsOn": ["flags"]
      },
      {
        "id": "rollback",
        "name": "回滚触发器",
        "nameZh": "回滚触发器",
        "type": "llm",
        "input": { "canary": "{{steps.canary.output}}", "budget": "{{input.rollbackBudgetMinutes}}" },
        "prompt": "为每个阶段定义自动回滚触发条件（错误率/延迟/业务指标），含 burn rate 多窗口阈值",
        "output": "rollbackTriggers",
        "dependsOn": ["canary"]
      },
      {
        "id": "verify",
        "name": "验证看板",
        "nameZh": "验证看板",
        "atomicSkill": "grafana-dashboard",
        "input": { "canary": "{{steps.canary.output}}", "triggers": "{{steps.rollback.output}}" },
        "output": "verificationDashboard",
        "dependsOn": ["rollback"]
      }
    ]
  },
  "errorHandling": { "strategy": "stop" }
}
