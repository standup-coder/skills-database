{
  "$schema": "../schema/composite-skill-v1.json",
  "id": "content-marketing-campaign",
  "type": "composite-skill",
  "version": "1.0.0",
  "metadata": {
    "name": "Content Marketing Campaign",
    "nameZh": "内容营销战役",
    "description": "Plan and execute a multi-channel content campaign with measurable funnel impact",
    "descriptionZh": "围绕漏斗目标设计并执行多渠道内容战役：受众 → 主题群 → 日历 → 分发 → 复盘",
    "author": "skills4coder-team",
    "tags": ["content-marketing", "seo", "campaign", "funnel", "marketing"],
    "category": "marketing"
  },
  "input": {
    "schema": {
      "type": "object",
      "properties": {
        "goal": { "type": "string", "enum": ["awareness", "lead-gen", "activation", "retention"] },
        "audience": { "type": "object" },
        "channels": { "type": "array", "items": { "type": "string" } },
        "budgetUsd": { "type": "number", "minimum": 0 },
        "durationWeeks": { "type": "integer", "minimum": 1 }
      },
      "required": ["goal", "audience", "channels"]
    }
  },
  "output": {
    "schema": {
      "type": "object",
      "properties": {
        "narrative": { "type": "string" },
        "topicCluster": { "type": "object" },
        "contentCalendar": { "type": "array" },
        "distributionPlan": { "type": "object" },
        "kpiDashboard": { "type": "object" }
      }
    }
  },
  "workflow": {
    "description": "内容战役五步法：叙事 → 主题群 → 日历 → 分发 → 监测",
    "steps": [
      {
        "id": "narrative",
        "name": "战役叙事定义",
        "nameZh": "战役叙事定义",
        "type": "llm",
        "input": { "goal": "{{input.goal}}", "audience": "{{input.audience}}" },
        "prompt": "输出一句话核心叙事 + 受众痛点 + Tone & Voice 规则",
        "output": "narrative"
      },
      {
        "id": "topics",
        "name": "主题群与关键词",
        "nameZh": "主题群与关键词",
        "atomicSkill": "seo-optimization",
        "input": { "narrative": "{{steps.narrative.output}}", "audience": "{{input.audience}}" },
        "output": "topicCluster",
        "dependsOn": ["narrative"]
      },
      {
        "id": "calendar",
        "name": "内容日历",
        "nameZh": "内容日历",
        "atomicSkill": "content-marketing",
        "input": { "topics": "{{steps.topics.output}}", "weeks": "{{input.durationWeeks}}", "channels": "{{input.channels}}" },
        "output": "contentCalendar",
        "dependsOn": ["topics"]
      },
      {
        "id": "distribution",
        "name": "分发计划",
        "nameZh": "分发计划",
        "atomicSkill": "growth-automation",
        "input": { "calendar": "{{steps.calendar.output}}", "budget": "{{input.budgetUsd}}", "channels": "{{input.channels}}" },
        "output": "distributionPlan",
        "dependsOn": ["calendar"]
      },
      {
        "id": "kpi",
        "name": "KPI 与看板",
        "nameZh": "KPI 与看板",
        "atomicSkill": "funnel-analysis",
        "input": { "goal": "{{input.goal}}" },
        "output": "kpiDashboard",
        "dependsOn": ["distribution"]
      }
    ]
  },
  "errorHandling": { "strategy": "continue" }
}
