{
  "$schema": "../schema/skill-v1.json",
  "id": "cloud-infrastructure-hardening",
  "type": "composite-skill",
  "version": "1.0.0",

  "metadata": {
    "name": "Cloud Infrastructure Hardening",
    "nameZh": "云基础设施加固",
    "description": "对云网络、计算、存储资源进行安全加固，消除错误配置和攻击面",
    "descriptionZh": "对云网络、计算、存储资源进行安全加固，消除错误配置和攻击面",
    "author": "skills4coder-team",
    "tags": ["cloud-security", "hardening", "vpc", "cis", "network"],
    "category": "security"
  },

  "input": {
    "schema": {
      "type": "object",
      "properties": {
        "targetPath": {
          "type": "string",
          "description": "云基础设施配置路径（Terraform / CloudFormation / ARM / Pulumi）"
        },
        "cloudProvider": {
          "type": "string",
          "enum": ["aws", "azure", "gcp", "tencent-cloud"],
          "default": "aws"
        },
        "hardeningProfile": {
          "type": "string",
          "enum": ["cis-benchmark", "nist-800-53", "soc2", "custom"],
          "default": "cis-benchmark",
          "description": "加固基准"
        }
      },
      "required": ["targetPath"]
    }
  },

  "output": {
    "schema": {
      "type": "object",
      "properties": {
        "passed": { "type": "boolean" },
        "hardeningScore": { "type": "number" },
        "totalChecks": { "type": "number" },
        "passedChecks": { "type": "number" },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "severity": { "enum": ["critical", "high", "medium", "low"] },
              "category": { "enum": ["network", "compute", "storage", "database", "logging", "iam", "dns"] },
              "resource": { "type": "string" },
              "file": { "type": "string" },
              "issue": { "type": "string" },
              "remediation": { "type": "string" },
              "benchmarkRef": { "type": "string" }
            }
          }
        }
      }
    }
  },

  "workflow": {
    "description": "云基础设施加固工作流",
    "steps": [
      {
        "id": "list-infra-configs",
        "name": "列出基础设施配置",
        "atomicSkill": "run-shell-command",
        "input": {
          "command": "find {{input.targetPath}} -type f \\( -name '*.tf' -o -name '*.yaml' -o -name '*.yml' -o -name '*.json' -o -name '*.template' \\) | head -100"
        },
        "output": "infraFiles"
      },
      {
        "id": "scan-network-exposure",
        "name": "扫描网络暴露面",
        "atomicSkill": "run-shell-command",
        "input": {
          "command": "grep -rniE '(0\\.0\\.0\\.0/0|::/0|ingress.*cidr_blocks.*\\[\\\"0\\.0\\.0\\.0/0\\\"\\]|public_ip|associate_public_ip)' {{input.targetPath}} --include='*.tf' --include='*.json' --include='*.yaml' --include='*.yml' || echo 'No public exposure found'"
        },
        "output": "networkExposure"
      },
      {
        "id": "scan-unencrypted-resources",
        "name": "扫描未加密资源",
        "atomicSkill": "run-shell-command",
        "input": {
          "command": "grep -rniE '(encryption.*disable|encrypted.*false|\\\"encrypted\\\"\\s*:\\s*false|no.*kms)' {{input.targetPath}} --include='*.tf' --include='*.json' --include='*.yaml' --include='*.yml' || echo 'All resources appear encrypted'"
        },
        "output": "encryptionGaps"
      },
      {
        "id": "scan-logging-gaps",
        "name": "扫描日志缺失",
        "atomicSkill": "run-shell-command",
        "input": {
          "command": "grep -rniE '(cloudtrail|flow_log|cloud_watch|vpc_flow|access_log|audit_log|trail)' {{input.targetPath}} --include='*.tf' --include='*.json' --include='*.yaml' --include='*.yml' | head -20 || echo 'No logging configuration found'"
        },
        "output": "loggingConfig"
      },
      {
        "id": "scan-compute-security",
        "name": "扫描计算资源安全",
        "atomicSkill": "run-shell-command",
        "input": {
          "command": "grep -rniE '(user_data|metadata|IMDSv1|ssm|ssh.*authorized_keys|metadata_service)' {{input.targetPath}} --include='*.tf' --include='*.json' --include='*.yaml' --include='*.yml' || echo 'No compute security issues found'"
        },
        "output": "computeScanResult"
      },
      {
        "id": "llm-hardening",
        "name": "AI 加固分析",
        "type": "llm",
        "input": {
          "infraFiles": "{{steps.list-infra-configs.output.stdout}}",
          "networkExposure": "{{steps.scan-network-exposure.output.stdout}}",
          "encryptionGaps": "{{steps.scan-unencrypted-resources.output.stdout}}",
          "loggingConfig": "{{steps.scan-logging-gaps.output.stdout}}",
          "computeScan": "{{steps.scan-compute-security.output.stdout}}",
          "cloudProvider": "{{input.cloudProvider}}",
          "hardeningProfile": "{{input.hardeningProfile}}"
        },
        "prompt": "你是一位云基础设施安全加固专家。请根据扫描结果，按 {{input.hardeningProfile}} 基准对 {{input.cloudProvider}} 云资源进行安全评估。重点检查：1) 网络/安全组/公开暴露 2) 数据加密（存储/传输） 3) 日志审计覆盖 4) 计算资源加固（IMDSv2、SSH 限制）5) 数据库安全。按 critical/high/medium/low 输出 findings（含 severity/category/resource/file/issue/remediation/benchmarkRef），给出 hardeningScore（0-100）和 passed 状态。",
        "output": "hardeningResult"
      },
      {
        "id": "format-output",
        "name": "格式化输出",
        "type": "transform",
        "input": {
          "hardeningResult": "{{steps.llm-hardening.output}}"
        },
        "transform": "formatInfrastructureHardening",
        "output": "finalResult"
      }
    ]
  },

  "errorHandling": {
    "strategy": "continue",
    "fallback": {
      "step": "llm-hardening",
      "action": "skip-partial"
    }
  }
}
