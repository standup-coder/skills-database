{
  "$schema": "../schema/composite-skill-v1.json",
  "id": "data-warehouse-design",
  "type": "composite-skill",
  "version": "1.0.0",
  "metadata": {
    "name": "Data Warehouse Design",
    "nameZh": "数据仓库建模",
    "description": "Design a layered data warehouse (ODS/DWD/DWS/ADS) with dimensional modeling and metric layer",
    "descriptionZh": "按 ODS/DWD/DWS/ADS 分层与维度建模理论设计数据仓库，并落地指标层与一致性维度",
    "author": "skills4coder-team",
    "tags": ["data-warehouse", "dimensional-modeling", "metrics-layer", "kimball", "data"],
    "category": "data"
  },
  "input": {
    "schema": {
      "type": "object",
      "properties": {
        "businessProcesses": { "type": "array", "items": { "type": "string" } },
        "engine": { "type": "string", "enum": ["snowflake", "bigquery", "redshift", "doris", "starrocks", "hive"] },
        "metricsCatalog": { "type": "array" }
      },
      "required": ["businessProcesses", "engine"]
    }
  },
  "output": {
    "schema": {
      "type": "object",
      "properties": {
        "layerModel": { "type": "object" },
        "factTables": { "type": "array" },
        "dimensionTables": { "type": "array" },
        "metricsLayer": { "type": "object" },
        "ddl": { "type": "string" }
      }
    }
  },
  "workflow": {
    "description": "维度建模四步法 + 指标层与分层规范",
    "steps": [
      {
        "id": "process-matrix",
        "name": "业务过程-维度矩阵",
        "nameZh": "业务过程-维度矩阵",
        "atomicSkill": "warehouse-design",
        "input": { "processes": "{{input.businessProcesses}}" },
        "output": "busMatrix"
      },
      {
        "id": "grain",
        "name": "确定粒度",
        "nameZh": "确定粒度",
        "type": "llm",
        "input": { "matrix": "{{steps.process-matrix.output}}" },
        "prompt": "对每个业务过程明确事实表粒度（最细粒度优先），输出粒度声明",
        "output": "grainSpec",
        "dependsOn": ["process-matrix"]
      },
      {
        "id": "dimensions",
        "name": "维度建模",
        "nameZh": "维度建模",
        "atomicSkill": "warehouse-design",
        "input": { "grain": "{{steps.grain.output}}" },
        "output": "dimensionTables",
        "dependsOn": ["grain"]
      },
      {
        "id": "facts",
        "name": "事实表设计",
        "nameZh": "事实表设计",
        "atomicSkill": "warehouse-design",
        "input": { "grain": "{{steps.grain.output}}", "dims": "{{steps.dimensions.output}}" },
        "output": "factTables",
        "dependsOn": ["dimensions"]
      },
      {
        "id": "metrics",
        "name": "指标层与一致性维度",
        "nameZh": "指标层与一致性维度",
        "type": "transform",
        "input": { "facts": "{{steps.facts.output}}", "catalog": "{{input.metricsCatalog}}" },
        "output": "metricsLayer",
        "dependsOn": ["facts"]
      },
      {
        "id": "ddl",
        "name": "DDL 生成",
        "nameZh": "DDL 生成",
        "type": "transform",
        "input": { "facts": "{{steps.facts.output}}", "dims": "{{steps.dimensions.output}}", "engine": "{{input.engine}}" },
        "output": "ddl",
        "dependsOn": ["metrics"]
      }
    ]
  },
  "errorHandling": {
    "strategy": "stop"
  }
}
