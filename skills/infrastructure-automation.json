{
  "id": "infrastructure-automation",
  "type": "composite-skill",
  "version": "1.0.0",
  "metadata": {
    "name": "Infrastructure Automation",
    "nameZh": "基础设施自动化",
    "description": "Terraform, Ansible and GitOps workflows",
    "descriptionZh": "Terraform、Ansible和GitOps工作流",
    "author": "skills4coder-team",
    "tags": [
      "terraform",
      "ansible",
      "gitops",
      "iac"
    ],
    "category": "devops"
  },
  "input": {
    "schema": {
      "type": "object",
      "properties": {},
      "required": []
    }
  },
  "output": {
    "schema": {
      "type": "object",
      "properties": {},
      "required": []
    }
  },
  "workflow": {
    "description": "Terraform, Ansible and GitOps workflows",
    "steps": [
      {
        "id": "design-infra",
        "name": "Design Infrastructure",
        "nameZh": "设计基础设施",
        "type": "llm",
        "input": {},
        "output": "infra_spec"
      },
      {
        "id": "write-terraform",
        "name": "Write Terraform",
        "nameZh": "编写Terraform",
        "atomicSkill": "write-file",
        "input": {
          "path": "terraform/main.tf",
          "content": "{{steps.design-infra.output}}"
        },
        "output": "tf_files",
        "dependsOn": [
          "design-infra"
        ]
      },
      {
        "id": "write-ansible",
        "name": "Write Ansible",
        "nameZh": "编写Ansible",
        "atomicSkill": "write-file",
        "input": {
          "path": "ansible/playbook.yml",
          "content": "{{steps.design-infra.output}}"
        },
        "output": "playbooks",
        "dependsOn": [
          "design-infra"
        ]
      }
    ]
  }
