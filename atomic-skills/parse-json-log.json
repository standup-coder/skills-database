{
  "$schema": "../schema/atomic-skill-v1.json",
  "id": "parse-json-log",
  "type": "atomic-skill",
  "version": "1.0.0",
  "metadata": {
    "name": "Parse JSON Log",
    "nameZh": "解析 JSON 日志",
    "description": "Parse and filter structured JSON logs",
    "descriptionZh": "解析并过滤结构化 JSON 日志",
    "author": "skills4coder-team",
    "tags": [
      "log",
      "json",
      "parser",
      "ops"
    ],
    "category": "data"
  },
  "input": {
    "schema": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "description": "日志内容（多行 JSON）"
        },
        "filter": {
          "type": "object",
          "description": "过滤条件，如 { level: 'ERROR' }"
        },
        "timeRange": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "format": "date-time"
            },
            "end": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "limit": {
          "type": "number",
          "default": 100,
          "description": "返回最大条目数"
        }
      },
      "required": [
        "content"
      ]
    }
  },
  "output": {
    "schema": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "解析后的日志条目"
        },
        "matchedCount": {
          "type": "number",
          "description": "匹配条数"
        },
        "totalCount": {
          "type": "number",
          "description": "总条数"
        },
        "summary": {
          "type": "object",
          "description": "级别分布等统计"
        }
      },
      "required": [
        "entries",
        "matchedCount",
        "totalCount"
      ]
    }
  },
  "implementation": {
    "type": "native",
    "function": "JSON.parse",
    "module": "global"
  },
  "constraints": {
    "permissions": [
      "read"
    ],
    "maxInputSize": 52428800,
    "maxEntries": 10000
  },
  "errors": {
    "INVALID_JSON": {
      "code": "E301",
      "message": "日志包含非法 JSON",
      "retryable": false
    },
    "INPUT_TOO_LARGE": {
      "code": "E302",
      "message": "日志内容超过大小限制",
      "retryable": false
    }
  },
  "learning": {
    "summaryZh": "JSON 日志解析是可观测性入口：schema 漂移、超大行、嵌套字段是三大坑。",
    "keyPoints": [
      "日志单行 JSON（NDJSON）是事实标准，禁用多行 pretty print",
      "必须容忍 schema 漂移：未知字段忽略、缺失字段默认值",
      "超长行（> 1MB）应截断或转 reference 存对象存储",
      "时间字段用 ISO 8601 + 时区，禁用本地时间",
      "level / service / trace_id 是检索黄金三件套"
    ],
    "bestPractices": [
      "解析失败的行进 dead-letter，不丢弃，便于回溯",
      "用 streaming JSON parser 处理大批量日志",
      "把嵌套对象 flatten 成 dot notation，方便索引",
      "为关键字段建立 schema 版本，向后兼容",
      "解析后注入 ingestion_time，识别延迟链路"
    ],
    "antiPatterns": [
      "用 JSON.parse 一行一行同步 parse 100k 行，CPU 拉满",
      "解析失败直接 drop 日志，事故复盘无证据",
      "把整个 message 字段 base64 后塞进搜索引擎",
      "不区分 level，全部当 INFO 索引爆磁盘",
      "trace_id 缺失却号称\"我们有可观测\""
    ],
    "resources": [
      {
        "title": "NDJSON spec",
        "url": "http://ndjson.org/",
        "type": "doc"
      },
      {
        "title": "OpenTelemetry Logs Data Model",
        "url": "https://opentelemetry.io/docs/specs/otel/logs/data-model/",
        "type": "doc"
      },
      {
        "title": "Elastic Common Schema (ECS)",
        "url": "https://www.elastic.co/guide/en/ecs/current/index.html",
        "type": "doc"
      }
    ],
    "maturityLevels": {
      "junior": "能 parse NDJSON、提取 level / message / timestamp",
      "mid": "能处理 schema 漂移、dead-letter、流式 parse 大文件",
      "senior": "能制定全公司日志规范：schema 版本 / 关键字段 / 与 trace 关联"
    }
  }
}
