{
  "$schema": "../schema/atomic-skill-v1.json",
  "id": "run-shell-command",
  "type": "atomic-skill",
  "version": "1.0.0",
  "metadata": {
    "name": "Run Shell Command",
    "nameZh": "执行 Shell 命令",
    "description": "Execute a controlled shell command with output capture",
    "descriptionZh": "在受控环境下执行 Shell 命令并捕获输出",
    "author": "skills4coder-team",
    "tags": [
      "shell",
      "exec",
      "cli",
      "ops"
    ],
    "category": "system"
  },
  "input": {
    "schema": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "description": "要执行的 shell 命令"
        },
        "cwd": {
          "type": "string",
          "description": "工作目录（可选）"
        },
        "timeout": {
          "type": "number",
          "default": 30000,
          "description": "超时时间（毫秒）"
        },
        "env": {
          "type": "object",
          "description": "额外环境变量"
        }
      },
      "required": [
        "command"
      ]
    }
  },
  "output": {
    "schema": {
      "type": "object",
      "properties": {
        "stdout": {
          "type": "string",
          "description": "标准输出"
        },
        "stderr": {
          "type": "string",
          "description": "标准错误"
        },
        "exitCode": {
          "type": "number",
          "description": "退出码"
        }
      },
      "required": [
        "stdout",
        "stderr",
        "exitCode"
      ]
    }
  },
  "implementation": {
    "type": "native",
    "function": "child_process.execSync",
    "module": "child_process"
  },
  "constraints": {
    "permissions": [
      "read",
      "exec"
    ],
    "blockedCommands": [
      "rm -rf /",
      "mkfs",
      "dd if=/dev/zero",
      ":(){ :|:& };:"
    ],
    "allowedCommands": [
      "docker",
      "kubectl",
      "terraform",
      "ansible",
      "git",
      "curl",
      "jq",
      "cat",
      "ls",
      "ps",
      "top",
      "htop",
      "df",
      "free",
      "uname",
      "npm",
      "node",
      "python3",
      "pip",
      "make",
      "mkdir",
      "cp",
      "mv",
      "rm -rf ./"
    ],
    "timeout": 30000,
    "maxOutputSize": 10485760
  },
  "errors": {
    "COMMAND_BLOCKED": {
      "code": "E101",
      "message": "命令被安全策略拦截",
      "retryable": false
    },
    "TIMEOUT": {
      "code": "E102",
      "message": "命令执行超时",
      "retryable": true
    },
    "NON_ZERO_EXIT": {
      "code": "E103",
      "message": "命令返回非零退出码",
      "retryable": false
    }
  },
  "learning": {
    "summaryZh": "执行 shell 命令是 agent 能力最强但最危险的操作；输入消毒、超时、白名单是三道生死线。",
    "keyPoints": [
      "永远不要用 string 拼接构造命令，必须用 argv 数组",
      "必须设超时（默认 ≤30s），无超时等于无穷阻塞",
      "必须设最大输出缓冲（防止 OOM 和日志爆炸）",
      "env 显式传递，避免污染来自宿主的敏感变量",
      "shell: false 是默认值，shell: true 仅在显式需要管道时打开",
      "退出码非 0 ≠ 失败：grep / diff 等以非 0 表达正常状态"
    ],
    "bestPractices": [
      "建立命令白名单（git / ls / cat...）+ 黑名单（rm -rf / curl ... | sh）",
      "通过 spawn 而非 exec 处理大输出，stream 转 line-by-line",
      "为高危命令引入二次确认（destructive=true 标记）",
      "所有命令执行落审计日志：cmd / args / cwd / exitCode / duration",
      "在容器或 chroot 中跑非可信命令"
    ],
    "antiPatterns": [
      "execSync(`rm -rf ${userInput}`) — 命令注入经典反例",
      "不设超时导致 agent 卡死",
      "把 stdout 全量塞回 LLM context 导致 token 爆炸",
      "依赖 shell 解析特殊字符却没引号转义",
      "在生产环境直接以 root 跑 agent 命令"
    ],
    "resources": [
      {
        "title": "Node.js child_process 官方文档",
        "url": "https://nodejs.org/api/child_process.html",
        "type": "doc"
      },
      {
        "title": "OWASP Command Injection",
        "url": "https://owasp.org/www-community/attacks/Command_Injection",
        "type": "article"
      },
      {
        "title": "execa: better child_process",
        "url": "https://github.com/sindresorhus/execa",
        "type": "doc"
      }
    ],
    "maturityLevels": {
      "junior": "能用 spawn 安全执行预定义命令，处理 exit code 和超时",
      "mid": "能设计命令白名单 + 沙箱，处理流式大输出与跨平台差异",
      "senior": "能为 agent 平台制定命令安全规范，含审计、配额、危险动作拦截策略"
    }
  }
}
