{
  "$schema": "../schema/atomic-skill-v1.json",
  "id": "run-shell-command",
  "type": "atomic-skill",
  "version": "1.0.0",

  "metadata": {
    "name": "Run Shell Command",
    "nameZh": "执行 Shell 命令",
    "description": "Execute a controlled shell command with output capture",
    "descriptionZh": "在受控环境下执行 Shell 命令并捕获输出",
    "author": "skills4coder-team",
    "tags": ["shell", "exec", "cli", "ops"],
    "category": "system"
  },

  "input": {
    "schema": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "description": "要执行的 shell 命令"
        },
        "cwd": {
          "type": "string",
          "description": "工作目录（可选）"
        },
        "timeout": {
          "type": "number",
          "default": 30000,
          "description": "超时时间（毫秒）"
        },
        "env": {
          "type": "object",
          "description": "额外环境变量"
        }
      },
      "required": ["command"]
    }
  },

  "output": {
    "schema": {
      "type": "object",
      "properties": {
        "stdout": {
          "type": "string",
          "description": "标准输出"
        },
        "stderr": {
          "type": "string",
          "description": "标准错误"
        },
        "exitCode": {
          "type": "number",
          "description": "退出码"
        }
      },
      "required": ["stdout", "stderr", "exitCode"]
    }
  },

  "implementation": {
    "type": "native",
    "function": "child_process.execSync",
    "module": "child_process"
  },

  "constraints": {
    "permissions": ["read", "exec"],
    "blockedCommands": [
      "rm -rf /",
      "mkfs",
      "dd if=/dev/zero",
      ":(){ :|:& };:"
    ],
    "allowedCommands": [
      "docker",
      "kubectl",
      "terraform",
      "ansible",
      "git",
      "curl",
      "jq",
      "cat",
      "ls",
      "ps",
      "top",
      "htop",
      "df",
      "free",
      "uname",
      "npm",
      "node",
      "python3",
      "pip",
      "make",
      "mkdir",
      "cp",
      "mv",
      "rm -rf ./"
    ],
    "timeout": 30000,
    "maxOutputSize": 10485760
  },

  "errors": {
    "COMMAND_BLOCKED": {
      "code": "E101",
      "message": "命令被安全策略拦截",
      "retryable": false
    },
    "TIMEOUT": {
      "code": "E102",
      "message": "命令执行超时",
      "retryable": true
    },
    "NON_ZERO_EXIT": {
      "code": "E103",
      "message": "命令返回非零退出码",
      "retryable": false
    }
  }
}
