{
  "$schema": "../schema/atomic-skill-v1.json",
  "id": "service-mesh",
  "type": "atomic-skill",
  "version": "1.0.0",
  "metadata": {
    "name": "Service Mesh",
    "nameZh": "服务网格",
    "description": "Adopt a service mesh (Istio / Linkerd) for traffic management, security and observability.",
    "descriptionZh": "采用服务网格（Istio / Linkerd）实现流量治理、零信任安全与可观测。",
    "author": "skills4coder-team",
    "tags": ["microservices", "service-mesh", "istio", "linkerd", "observability"],
    "category": "microservices"
  },
  "input": {
    "schema": {
      "type": "object",
      "properties": {
        "platform": { "enum": ["istio", "linkerd", "consul", "cilium"] },
        "clusterScale": { "type": "string" },
        "requirements": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["platform"]
    }
  },
  "output": {
    "schema": {
      "type": "object",
      "properties": {
        "meshConfig": { "type": "object" },
        "trafficPolicies": { "type": "array", "items": { "type": "object" } },
        "mTLSConfig": { "type": "object" }
      }
    }
  },
  "implementation": {
    "type": "native",
    "function": "service_mesh"
  },
  "constraints": {
    "permissions": ["read", "write"]
  },
  "errors": {
    "SIDECAR_OOM": { "code": "MESH_001", "message": "Sidecar 内存超限", "retryable": false },
    "POLICY_CONFLICT": { "code": "MESH_002", "message": "流量策略冲突", "retryable": false }
  },
  "learning": {
    "summaryZh": "服务网格把通用网络能力（mTLS、重试、熔断、tracing）下沉到 sidecar，但代价是复杂度与延迟。",
    "keyPoints": [
      "三大能力域：traffic（路由/重试/熔断）、security（mTLS/AuthZ）、observability（tracing/metrics）",
      "Istio 功能全但重；Linkerd 轻量；Cilium 走 eBPF 路线",
      "Sidecar 模式 vs Sidecar-less（ambient mesh）权衡延迟与隔离",
      "灰度/金丝雀靠 VirtualService 实现，比应用内 SDK 解耦",
      "mTLS 默认开启可零信任，但需处理证书轮转",
      "网格 ≠ 银弹：服务数 <10 的小系统不必上"
    ],
    "bestPractices": [
      "渐进式接入：先观测，再 mTLS，最后流量策略",
      "为每个服务定义 SLO，结合网格指标闭环",
      "限制 sidecar CPU/Mem，避免吃掉应用资源",
      "升级网格用 canary 策略，先升 sidecar 再升 control plane",
      "明确网格能力边界，应用 SDK 不再做重试/熔断"
    ],
    "antiPatterns": [
      "服务数极少就上 Istio，复杂度远超收益",
      "应用 SDK 与 mesh 同时做重试，导致雪崩",
      "Sidecar 与应用容器共享 limit 导致 OOM",
      "策略写死在 yaml 没版本化",
      "mTLS 半开半关，留下安全死角"
    ],
    "resources": [
      { "title": "Istio Docs", "url": "https://istio.io/latest/docs/", "type": "doc" },
      { "title": "Linkerd Docs", "url": "https://linkerd.io/2/", "type": "doc" },
      { "title": "Service Mesh Patterns", "url": "https://www.oreilly.com/library/view/istio-in-action/9781617295829/", "type": "book" },
      { "title": "Ambient Mesh (Istio)", "url": "https://istio.io/latest/blog/2022/introducing-ambient-mesh/", "type": "article" },
      { "title": "eBPF & Cilium", "url": "https://cilium.io/", "type": "tool" }
    ],
    "maturityLevels": {
      "junior": "能在测试集群部署 Istio/Linkerd，理解 sidecar 概念",
      "mid": "能配置 VirtualService、DestinationRule、PeerAuthentication 等",
      "senior": "能在多集群、多租户场景做网格架构选型与演进"
    }
  }
}
