{
  "$schema": "../schema/atomic-skill-v1.json",
  "id": "data-classification-dlp",
  "type": "atomic-skill",
  "version": "1.0.0",
  "metadata": {
    "name": "Data Classification & DLP",
    "nameZh": "数据分类与 DLP",
    "description": "Classify data sensitivity and prevent leakage using DLP scanning, masking, and policy controls.",
    "descriptionZh": "对数据敏感度进行分类，结合 DLP 扫描 / 脱敏 / 策略控制防止泄漏。",
    "author": "skills4coder-team",
    "tags": [
      "security",
      "data",
      "dlp",
      "classification",
      "pii"
    ],
    "category": "security"
  },
  "input": {
    "schema": {
      "type": "object",
      "required": [
        "scope"
      ],
      "properties": {
        "scope": {
          "type": "string"
        },
        "classes": {
          "type": "array",
          "items": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          }
        },
        "tool": {
          "type": "string",
          "enum": [
            "macie",
            "gcp-dlp",
            "purview",
            "bigid"
          ]
        }
      }
    }
  },
  "output": {
    "schema": {
      "type": "object",
      "properties": {
        "classification": {
          "type": "object"
        },
        "leakRisks": {
          "type": "array"
        },
        "policies": {
          "type": "array"
        }
      }
    }
  },
  "implementation": {
    "type": "native",
    "function": "data_classification_dlp"
  },
  "errors": {
    "LABEL_DRIFT": {
      "code": "DLP_001",
      "message": "数据 label 与实际内容不一致",
      "retryable": false
    }
  },
  "constraints": {
    "permissions": [
      "read"
    ]
  },
  "learning": {
    "summaryZh": "没有分类的 DLP 是无差别拦截，会被业务规避；先做 classification，再 DLP，才是可执行路径。",
    "keyPoints": [
      "四级分类（public / internal / confidential / restricted）",
      "auto-tag + manual review 结合",
      "DLP 在通道（email / chat / upload）拦截",
      "tokenization > masking",
      "data lineage 配合分类"
    ],
    "bestPractices": [
      "Macie / DLP 自动扫描 + label",
      "高敏数据走专用 KMS",
      "DLP rule 与分类绑定",
      "每年 review 分类标准"
    ],
    "antiPatterns": [
      "DLP 一刀切阻断引发业务绕道",
      "数据无分类直接上 DLP",
      "只扫 storage 不扫 channel",
      "分类标准长期不更新"
    ],
    "resources": [
      {
        "title": "AWS Macie",
        "url": "https://docs.aws.amazon.com/macie/",
        "type": "doc"
      },
      {
        "title": "GCP DLP",
        "url": "https://cloud.google.com/dlp/docs",
        "type": "doc"
      },
      {
        "title": "Microsoft Purview",
        "url": "https://learn.microsoft.com/en-us/purview/",
        "type": "doc"
      }
    ],
    "maturityLevels": {
      "junior": "能用工具做基础分类扫描",
      "mid": "能落地 classification + DLP policy 闭环",
      "senior": "能驱动组织级 data governance 战略"
    }
  }
}
