{
  "$schema": "../schema/atomic-skill-v1.json",
  "id": "log-parser",
  "type": "atomic-skill",
  "version": "1.1.0",
  "metadata": {
    "name": "Log Parser",
    "nameZh": "日志解析",
    "description": "Parse structured and unstructured log files, extract patterns, and identify anomalies",
    "descriptionZh": "解析结构化和非结构化日志文件，提取模式并识别异常",
    "author": "skills4coder-team",
    "tags": [
      "log",
      "parse",
      "observability"
    ],
    "category": "logging"
  },
  "input": {
    "schema": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "description": "Log file path or glob pattern (e.g., /var/log/app/*.log)"
        },
        "format": {
          "type": "string",
          "enum": ["json", "text", "syslog", "apache", "nginx", "custom"],
          "default": "text",
          "description": "Log format to parse"
        },
        "pattern": {
          "type": "string",
          "description": "Custom regex pattern for 'custom' format extraction"
        },
        "level": {
          "type": "string",
          "enum": ["TRACE", "DEBUG", "INFO", "WARN", "ERROR", "FATAL"],
          "description": "Minimum log level to include in results"
        },
        "timeRange": {
          "type": "object",
          "description": "Time window filter",
          "properties": {
            "start": { "type": "string", "format": "date-time" },
            "end": { "type": "string", "format": "date-time" }
          }
        },
        "grep": {
          "type": "string",
          "description": "Filter lines matching this regex pattern"
        },
        "tail": {
          "type": "number",
          "description": "Return only the last N lines (like tail -n)",
          "default": 1000
        },
        "groupBy": {
          "type": "string",
          "enum": ["level", "source", "time_bucket"],
          "description": "Group parsed entries by field for aggregation"
        }
      },
      "required": ["source"]
    }
  },
  "output": {
    "schema": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "description": "Parsed log entries",
          "items": {
            "type": "object",
            "properties": {
              "timestamp": { "type": "string", "format": "date-time" },
              "level": { "type": "string" },
              "message": { "type": "string" },
              "source": { "type": "string" },
              "fields": { "type": "object" }
            }
          }
        },
        "summary": {
          "type": "object",
          "description": "Aggregated statistics",
          "properties": {
            "totalLines": { "type": "number" },
            "parsedLines": { "type": "number" },
            "unparsedLines": { "type": "number" },
            "levelCounts": { "type": "object" },
            "errorRate": { "type": "number" },
            "timeSpan": { "type": "object" }
          }
        },
        "anomalies": {
          "type": "array",
          "description": "Detected anomalies (error spikes, unusual patterns)",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "description": { "type": "string" },
              "count": { "type": "number" },
              "firstSeen": { "type": "string" },
              "lastSeen": { "type": "string" }
            }
          }
        }
      },
      "required": ["entries", "summary"]
    }
  },
  "implementation": {
    "type": "native",
    "function": "log_parser",
    "fallback": {
      "type": "mcp-tool",
      "server": "filesystem",
      "tool": "read_file"
    }
  },
  "constraints": {
    "permissions": ["read"],
    "blockedPaths": [
      "/var/log/auth.log",
      "/var/log/secure",
      "**/*.key",
      "**/credentials*"
    ],
    "maxFileSize": 104857600,
    "maxEntries": 10000,
    "maxLineLength": 65536
  },
  "errors": {
    "FILE_NOT_FOUND": {
      "code": "E301",
      "message": "日志文件不存在",
      "retryable": false
    },
    "PARSE_FAILURE": {
      "code": "E302",
      "message": "日志格式无法识别，超过 50% 行无法解析",
      "retryable": false
    },
    "FILE_TOO_LARGE": {
      "code": "E303",
      "message": "日志文件超过大小限制，请使用 tail 或 timeRange 缩小范围",
      "retryable": false
    },
    "ENCODING_ERROR": {
      "code": "E304",
      "message": "文件编码无法识别",
      "retryable": false
    },
    "PERMISSION_DENIED": {
      "code": "E305",
      "message": "无权读取日志文件",
      "retryable": false
    }
  },
  "learning": {
    "summaryZh": "日志解析的难点不在正则匹配，而在时间戳格式混乱、多行堆栈关联、编码不一致和海量数据下的采样策略。",
    "keyPoints": [
      "时间戳格式千差万别（ISO8601/Unix epoch/Apache CLF），必须自动检测或显式指定",
      "多行日志（Java stacktrace、Python traceback）需要关联逻辑，不能逐行独立解析",
      "生产日志可能混杂多种格式（应用日志 + 框架日志），需要多 pattern 回退",
      "日志中可能包含 PII（邮箱/手机号/IP），解析后传给 LLM 前需脱敏",
      "大文件（>100MB）必须流式处理，不能一次性加载到内存"
    ],
    "bestPractices": [
      "优先尝试 JSON 格式解析，失败后回退到正则 pattern 匹配",
      "对多行日志实现 continuation 检测（以空格/tab 开头或无时间戳前缀的行归属上一条）",
      "提供 tail 模式避免全量读取，agent 通常只需要最近的错误",
      "输出 summary 统计（error rate / level 分布）让 agent 快速判断是否需要深入",
      "对无法解析的行保留原文并标记，而非静默丢弃"
    ],
    "antiPatterns": [
      "用单一正则硬编码所有日志格式，遇到新格式直接崩溃",
      "把 10GB 日志全部解析后塞进 LLM context",
      "忽略多行堆栈导致每条 trace 行被当作独立错误",
      "不处理时区信息导致跨时区日志时间线错乱",
      "将包含用户密码/token 的日志原文传给 LLM 分析"
    ],
    "resources": [
      {
        "title": "Grok Patterns - Logstash",
        "url": "https://www.elastic.co/guide/en/logstash/current/plugins-filters-grok.html",
        "type": "doc"
      },
      {
        "title": "The Twelve-Factor App - Logs",
        "url": "https://12factor.net/logs",
        "type": "article"
      }
    ],
    "maturityLevels": {
      "junior": "能解析标准 JSON 日志、按 level 过滤、提取时间戳和消息",
      "mid": "能处理多行堆栈、多格式回退、时间范围过滤、生成统计摘要",
      "senior": "能为 agent 设计日志分析策略：流式采样、异常检测、PII 脱敏、与告警系统集成"
    }
  }
}
