{
  "id": "write-file",
  "type": "atomic-skill",
  "version": "1.0.0",
  "metadata": {
    "name": "write-file",
    "nameZh": "写文件",
    "description": "Write content to a file at the specified path",
    "descriptionZh": "将内容写入指定路径的文件",
    "author": "skills4coder",
    "tags": ["file", "write", "atomic"],
    "category": "file"
  },
  "input": {
    "schema": {
      "type": "object",
      "required": ["path", "content"],
      "properties": {
        "path": { "type": "string", "description": "File path to write to" },
        "content": { "type": "string", "description": "Content to write" },
        "append": { "type": "boolean", "description": "Append to existing file", "default": false }
      }
    }
  },
  "output": {
    "schema": {
      "type": "object",
      "properties": {
        "success": { "type": "boolean" },
        "path": { "type": "string" },
        "bytesWritten": { "type": "number" }
      }
    }
  },
  "implementation": {
    "type": "native",
    "function": "writeFile"
  },
  "constraints": {
    "blockedPaths": ["**/.env", "**/credentials.json", "**/secrets/**"],
    "maxFileSize": 10485760
  }
}