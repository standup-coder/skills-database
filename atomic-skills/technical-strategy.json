{
  "$schema": "../schema/atomic-skill-v1.json",
  "id": "technical-strategy",
  "type": "atomic-skill",
  "version": "1.0.0",
  "metadata": {
    "name": "Technical Strategy",
    "nameZh": "技术战略",
    "description": "Define technical strategy aligning with business goals, covering architecture, build-vs-buy, and tech investments.",
    "descriptionZh": "定义与业务目标对齐的技术战略：架构 / build vs buy / 技术投入。",
    "author": "skills4coder-team",
    "tags": [
      "leadership",
      "strategy",
      "architecture",
      "cto",
      "tech-investment"
    ],
    "category": "leadership"
  },
  "input": {
    "schema": {
      "type": "object",
      "required": [
        "horizon"
      ],
      "properties": {
        "horizon": {
          "type": "string",
          "enum": [
            "1y",
            "3y",
            "5y"
          ]
        },
        "businessGoals": {
          "type": "array"
        }
      }
    }
  },
  "output": {
    "schema": {
      "type": "object",
      "properties": {
        "strategyDoc": {
          "type": "string"
        },
        "bets": {
          "type": "array"
        },
        "kpi": {
          "type": "array"
        }
      }
    }
  },
  "implementation": {
    "type": "native",
    "function": "technical_strategy"
  },
  "errors": {
    "MISALIGNED_GOAL": {
      "code": "TS_001",
      "message": "技术战略与业务目标不对齐",
      "retryable": false
    }
  },
  "constraints": {
    "permissions": [
      "read"
    ]
  },
  "learning": {
    "summaryZh": "技术战略不是技术清单，是\"为什么不做某些事\"的判断；好的战略让团队 80% 决策无需上层介入。",
    "keyPoints": [
      "战略 = 诊断 + 引导政策 + 一致行动（Rumelt）",
      "build vs buy vs partner 三选一",
      "技术债与 product velocity 的 trade-off",
      "技术 bets 要能落到季度",
      "废止策略与新增同等重要"
    ],
    "bestPractices": [
      "Wardley Map 看技术演进",
      "tech radar 公开化",
      "每年回顾 bets 命中率",
      "strategy memo 不超过 6 页"
    ],
    "antiPatterns": [
      "\"我们要 AI\" 这种伪战略",
      "战略写完锁抽屉",
      "什么都做的\"全面战略\"",
      "技术债持续记账不还"
    ],
    "resources": [
      {
        "title": "Good Strategy Bad Strategy",
        "url": "https://www.goodbadstrategy.com/",
        "type": "book"
      },
      {
        "title": "Wardley Maps",
        "url": "https://medium.com/wardleymaps",
        "type": "article"
      },
      {
        "title": "Will Larson: Engineering Strategy",
        "url": "https://lethain.com/strategy/",
        "type": "article"
      }
    ],
    "maturityLevels": {
      "junior": "能理解战略文档",
      "mid": "能在团队级落地 tech bets",
      "senior": "能驱动公司级技术战略与多年投入"
    }
  }
}
