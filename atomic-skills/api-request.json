{
  "$schema": "../schema/atomic-skill-v1.json",
  "id": "api-request",
  "type": "atomic-skill",
  "version": "1.1.0",
  "metadata": {
    "name": "API Request",
    "nameZh": "API请求",
    "description": "Send structured HTTP API requests with authentication, retry logic, and response validation",
    "descriptionZh": "发送结构化 HTTP API 请求，支持认证、重试逻辑和响应校验",
    "author": "skills4coder-team",
    "tags": [
      "http",
      "api",
      "network"
    ],
    "category": "network"
  },
  "input": {
    "schema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "Target API endpoint URL (must be absolute)"
        },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"],
          "default": "GET",
          "description": "HTTP method to use"
        },
        "headers": {
          "type": "object",
          "description": "Request headers (Content-Type, Authorization, etc.)",
          "additionalProperties": {
            "type": "string"
          }
        },
        "body": {
          "type": "object",
          "description": "Request payload (auto-serialized based on Content-Type)"
        },
        "queryParams": {
          "type": "object",
          "description": "URL query parameters to append",
          "additionalProperties": {
            "type": "string"
          }
        },
        "auth": {
          "type": "object",
          "description": "Authentication configuration",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["bearer", "basic", "apiKey", "oauth2"]
            },
            "token": {
              "type": "string"
            },
            "username": {
              "type": "string"
            },
            "password": {
              "type": "string"
            }
          }
        },
        "timeout": {
          "type": "number",
          "description": "Request timeout in milliseconds",
          "default": 30000
        },
        "retries": {
          "type": "number",
          "description": "Number of retry attempts on transient failure",
          "default": 2
        },
        "validateStatus": {
          "type": "array",
          "items": { "type": "number" },
          "description": "Accepted HTTP status codes",
          "default": [200, 201, 202, 204]
        }
      },
      "required": ["url", "method"]
    }
  },
  "output": {
    "schema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "number",
          "description": "HTTP response status code"
        },
        "statusText": {
          "type": "string",
          "description": "HTTP response status text"
        },
        "headers": {
          "type": "object",
          "description": "Response headers",
          "additionalProperties": { "type": "string" }
        },
        "body": {
          "type": "object",
          "description": "Parsed response body (JSON object or string)"
        },
        "duration": {
          "type": "number",
          "description": "Request duration in milliseconds"
        },
        "retryCount": {
          "type": "number",
          "description": "Number of retries performed"
        }
      },
      "required": ["status", "body", "duration"]
    }
  },
  "implementation": {
    "type": "native",
    "function": "api_request",
    "fallback": {
      "type": "mcp-tool",
      "server": "fetch",
      "tool": "fetch"
    }
  },
  "constraints": {
    "permissions": ["network"],
    "blockedHosts": [
      "169.254.169.254",
      "metadata.google.internal",
      "localhost",
      "127.0.0.1",
      "0.0.0.0"
    ],
    "maxResponseSize": 10485760,
    "maxTimeout": 60000,
    "allowedSchemes": ["https", "http"],
    "rateLimit": {
      "maxRequestsPerMinute": 60,
      "burstLimit": 10
    }
  },
  "errors": {
    "CONNECTION_REFUSED": {
      "code": "E101",
      "message": "目标服务器拒绝连接",
      "retryable": true
    },
    "TIMEOUT": {
      "code": "E102",
      "message": "请求超时",
      "retryable": true
    },
    "AUTH_FAILED": {
      "code": "E103",
      "message": "认证失败（401/403）",
      "retryable": false
    },
    "RATE_LIMITED": {
      "code": "E104",
      "message": "触发速率限制（429）",
      "retryable": true
    },
    "INVALID_RESPONSE": {
      "code": "E105",
      "message": "响应格式无法解析",
      "retryable": false
    }
  },
  "learning": {
    "summaryZh": "API 请求的难点不在发出去，而在认证过期、幂等性、速率限制和响应不确定性——agent 必须像人类工程师一样处理边界情况。",
    "keyPoints": [
      "必须区分可重试错误（网络超时/429）和不可重试错误（401/400），盲目重试会放大故障",
      "认证 token 有生命周期，agent 需处理 401 后自动刷新 token 再重试一次",
      "POST/PUT 等非幂等请求重试前必须确认服务端幂等性，否则可能产生重复数据",
      "响应体可能是 JSON/XML/HTML/纯文本，必须根据 Content-Type 选择解析策略",
      "内网地址（169.254.169.254 等）必须拦截，防止 SSRF 攻击"
    ],
    "bestPractices": [
      "使用指数退避（exponential backoff）重试，避免雪崩",
      "设置合理超时（连接 5s + 读取 30s），防止 agent 长时间挂起",
      "请求前校验 URL scheme 和 host，拒绝 file:// 和元数据端点",
      "记录请求的 method/url/status/duration 用于审计追踪",
      "对大响应体设置 maxResponseSize，超限则截断并标记"
    ],
    "antiPatterns": [
      "对所有错误码统一重试导致 400 Bad Request 被反复发送",
      "把 API Key 硬编码在请求参数中而非从环境变量/密钥管理读取",
      "不设置超时让 agent 在慢接口上无限等待",
      "忽略 429 响应的 Retry-After 头直接立即重试",
      "将完整响应体（可能含敏感数据）直接写入日志或传给 LLM"
    ],
    "resources": [
      {
        "title": "MDN HTTP Overview",
        "url": "https://developer.mozilla.org/en-US/docs/Web/HTTP/Overview",
        "type": "doc"
      },
      {
        "title": "AWS SDK Retry and Exponential Backoff",
        "url": "https://docs.aws.amazon.com/general/latest/gr/api-retries.html",
        "type": "doc"
      }
    ],
    "maturityLevels": {
      "junior": "能正确构造 GET/POST 请求、解析 JSON 响应、处理基本错误码",
      "mid": "能实现认证刷新、指数退避重试、SSRF 防护、响应体大小限制",
      "senior": "能为 agent 设计完整的 API 调用策略：幂等性判断、熔断器模式、多区域 failover、与 LLM 工具调用协议集成"
    }
  }
}
