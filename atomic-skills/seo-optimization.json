{
  "$schema": "../schema/atomic-skill-v1.json",
  "id": "seo-optimization",
  "type": "atomic-skill",
  "version": "1.0.0",
  "metadata": {
    "name": "SEO Optimization",
    "nameZh": "SEO 优化",
    "description": "Improve organic search visibility through technical SEO, on-page optimization, content strategy and link building.",
    "descriptionZh": "通过技术 SEO / on-page / 内容策略 / 外链建设提升自然搜索可见度。",
    "author": "skills4coder-team",
    "tags": [
      "seo",
      "marketing",
      "organic",
      "growth",
      "content"
    ],
    "category": "marketing"
  },
  "input": {
    "schema": {
      "type": "object",
      "required": [
        "site"
      ],
      "properties": {
        "site": {
          "type": "string",
          "description": "网站域名"
        },
        "audit": {
          "enum": [
            "technical",
            "on-page",
            "content-gap",
            "backlink",
            "full"
          ],
          "default": "full"
        },
        "market": {
          "type": "string",
          "default": "global"
        }
      }
    }
  },
  "output": {
    "schema": {
      "type": "object",
      "properties": {
        "issues": {
          "type": "array"
        },
        "recommendations": {
          "type": "array"
        },
        "prioritizedBacklog": {
          "type": "array"
        }
      }
    }
  },
  "implementation": {
    "type": "native",
    "function": "seo_optimization"
  },
  "errors": {
    "INDEX_BLOCKED": {
      "code": "SEO_001",
      "message": "关键页面被 robots.txt / noindex 阻止",
      "retryable": false
    }
  },
  "constraints": {
    "permissions": [
      "read"
    ]
  },
  "learning": {
    "summaryZh": "SEO 是技术、内容、外链三角飞轮，任一边长期失修都会让另外两边白费力气。",
    "keyPoints": [
      "Core Web Vitals 与排名直接相关",
      "search intent > keyword volume",
      "internal linking 是被低估的杠杆",
      "GEO（Generative Engine Optimization）成新战场",
      "E-E-A-T 决定 YMYL 类目可见度"
    ],
    "bestPractices": [
      "用 GSC / Ahrefs / Semrush 三件套定期审计",
      "为关键词集群建立 pillar page + cluster",
      "schema.org 标记结构化数据",
      "定期清理 thin / duplicate content"
    ],
    "antiPatterns": [
      "关键词堆砌",
      "买垃圾外链触发惩罚",
      "JS 渲染但不做 SSR / prerender",
      "忽视 mobile / 速度，Core Web Vitals 全红"
    ],
    "resources": [
      {
        "title": "Google Search Central",
        "url": "https://developers.google.com/search",
        "type": "doc"
      },
      {
        "title": "Ahrefs SEO Guide",
        "url": "https://ahrefs.com/blog/seo/",
        "type": "doc"
      },
      {
        "title": "Core Web Vitals",
        "url": "https://web.dev/vitals/",
        "type": "doc"
      }
    ],
    "maturityLevels": {
      "junior": "能跑技术 SEO 审计、修基础问题",
      "mid": "能搭关键词地图、internal linking、CWV 优化",
      "senior": "能驱动跨团队 SEO 战略、GEO 适配、品牌可见度"
    }
  }
}
